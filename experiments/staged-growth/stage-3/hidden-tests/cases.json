{
  "cases": [
    {
      "id": "s3-text-day",
      "description": "Single key is the stage 1 layout",
      "args": [
        "--input",
        "orders.csv",
        "--group-by",
        "day"
      ],
      "expect": {
        "exitCode": 0,
        "stdout": "day\trevenue\n2026-03-01\t24.95\n2026-03-02\t10.75\n2026-03-03\t10.50\n2026-03-05\t7.00\nTOTAL\t53.20\n",
        "stderrPrefixes": [
          "orders.csv:8:",
          "orders.csv:9:"
        ]
      }
    },
    {
      "id": "s3-text-customer",
      "description": "Customer ids sort by code point (' before digits)",
      "args": [
        "--input",
        "orders.csv",
        "--group-by",
        "customer"
      ],
      "expect": {
        "exitCode": 0,
        "stdout": "customer\trevenue\nC'3\t7.00\nC1\t34.75\nC2\t11.45\nTOTAL\t53.20\n",
        "stderrPrefixes": [
          "orders.csv:8:",
          "orders.csv:9:"
        ]
      }
    },
