{
  "cases": [
    {
      "id": "s6-visible-cli-text-day-new-york",
      "description": "Days in New York, across the change to daylight saving time",
      "args": [
        "--input",
        "orders6.csv",
        "--group-by",
        "day",
        "--time-zone",
        "America/New_York"
      ],
      "expect": {
        "exitCode": 0,
        "stdout": "day\trevenue\n2026-03-01\t5.00 EUR\n2026-03-01\t4.00 JPY\n2026-03-01\t23.00\n2026-03-02\t2.00 EUR\n2026-03-02\t1.00\n2026-03-04\t1.00 EUR\n2026-03-04\t6.30\n2026-03-09\t1.00\nTOTAL\t8.00 EUR\nTOTAL\t4.00 JPY\nTOTAL\t31.30\n",
        "stderrPrefixes": [
          "orders6.csv:6:",
          "orders6.csv:8:",
          "orders6.csv:10:",
          "orders6.csv:11:",
          "orders6.csv:15:",
          "orders6.csv:16:"
        ]
      }
    },
    {
      "id": "s6-visible-cli-json-customer",
      "description": "JSON states the currency",
      "args": [
        "--input",
        "orders6.csv",
        "--group-by",
        "customer",
        "--output",
        "json"
      ],
      "expect": {
        "exitCode": 0,
        "stdout": "{\"groupBy\":[\"customer\"],\"rows\":[{\"key\":[\"C1\"],\"currency\":\"EUR\",\"revenue\":\"5.00\"},{\"key\":[\"C1\"],\"currency\":\"USD\",\"revenue\":\"26.30\"},{\"key\":[\"C2\"],\"currency\":\"EUR\",\"revenue\":\"1.00\"},{\"key\":[\"C2\"],\"currency\":\"JPY\",\"revenue\":\"4.00\"},{\"key\":[\"C2\"],\"currency\":\"USD\",\"revenue\":\"3.00\"},{\"key\":[\"C3\"],\"currency\":\"EUR\",\"revenue\":\"2.00\"},{\"key\":[\"C3\"],\"currency\":\"USD\",\"revenue\":\"1.00\"},{\"key\":[\"C4\"],\"currency\":\"USD\",\"revenue\":\"1.00\"}],\"totals\":[{\"currency\":\"EUR\",\"total\":\"8.00\"},{\"currency\":\"JPY\",\"total\":\"4.00\"},{\"currency\":\"USD\",\"total\":\"31.30\"}]}\n",
        "stderrPrefixes": [
          "orders6.csv:6:",
          "orders6.csv:8:",
          "orders6.csv:10:",
          "orders6.csv:11:",
          "orders6.csv:15:",
          "orders6.csv:16:"
        ]
      }
    },
    {
      "id": "s6-visible-report-utc",
      "description": "A line per week and currency, a TOTAL per currency",
      "tool": "report",
      "args": [
        "--input",
        "orders6.csv",
        "--out-dir",
        "out"
      ],
      "expect": {
        "exitCode": 0,
        "stdout": "",
        "stderrPrefixes": [
          "orders6.csv:6:",
          "orders6.csv:8:",
          "orders6.csv:10:",
          "orders6.csv:11:",
          "orders6.csv:15:",
          "orders6.csv:16:"
        ],
        "files": {
          "dir": "out",
          "contents": {
            "C1.txt": "customer\tC1\nweek\trevenue\n2026-W09\t5.00 EUR\n2026-W09\t20.00\n2026-W10\t6.30\nTOTAL\t5.00 EUR\nTOTAL\t26.30\n",
            "C2.txt": "customer\tC2\nweek\trevenue\n2026-W09\t4.00 JPY\n2026-W10\t1.00 EUR\n2026-W10\t3.00\nTOTAL\t1.00 EUR\nTOTAL\t4.00 JPY\nTOTAL\t3.00\n",
            "C3.txt": "customer\tC3\nweek\trevenue\n2026-W10\t2.00 EUR\n2026-W11\t1.00\nTOTAL\t2.00 EUR\nTOTAL\t1.00\n",
            "C4.txt": "customer\tC4\nweek\trevenue\n2026-W10\t1.00\nTOTAL\t1.00\n"
          }
        }
      }
    }
  ]
}
