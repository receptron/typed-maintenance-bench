        "files": {
          "dir": "out",
          "contents": {
            "C1.txt": "customer\tC1\nweek\trevenue\n2026-W52\t10.00\n2026-W53\t23.75\nTOTAL\t33.75\n",
            "C2.txt": "customer\tC2\nweek\trevenue\n2026-W53\t4.95\n2027-W01\t0.50\nTOTAL\t5.45\n",
            "C%2F3.txt": "customer\tC/3\nweek\trevenue\n2026-W53\t7.00\nTOTAL\t7.00\n",
            "C%2E1.txt": "customer\tC.1\nweek\trevenue\n2027-W01\t1.00\nTOTAL\t1.00\n"
          }
        }
      }
    },
    {
      "id": "s5-report-no-records",
      "description": "No valid records: no files",
      "tool": "report",
      "args": [
        "--input",
        "header.tsv",
        "--out-dir",
        "out"
      ],
      "expect": {
        "exitCode": 0,
        "stdout": "",
        "stderrPrefixes": [],
        "files": {
          "dir": "out",
          "contents": {}
        }
      }
    },
    {
      "id": "s5-report-bom",
      "description": "Report from TSV with a byte-order mark",
      "tool": "report",
      "args": [
        "--input",
        "bom.tsv",
        "--out-dir",
        "out"
      ],
      "expect": {
        "exitCode": 0,
        "stdout": "",
        "stderrPrefixes": [],
        "files": {
          "dir": "out",
          "contents": {
            "B1.txt": "customer\tB1\nweek\trevenue\n2026-W10\t2.00\nTOTAL\t2.00\n"
          }
        }
      }
    },
    {
      "id": "s5-report-utc",
      "description": "Weeks do not depend on the machine's time zone",
      "tool": "report",
      "args": [
        "--input",
        "orders.tsv",
        "--out-dir",
        "out"
      ],
      "env": {
        "TZ": "Pacific/Kiritimati"
      },
      "expect": {
        "exitCode": 0,
        "stdout": "",
        "stderrPrefixes": [
          "orders.tsv:9:",
          "orders.tsv:10:",
          "orders.tsv:11:"
        ],
        "files": {
          "dir": "out",
          "contents": {
            "C1.txt": "customer\tC1\nweek\trevenue\n2026-W52\t10.00\n2026-W53\t23.75\nTOTAL\t33.75\n",
            "C2.txt": "customer\tC2\nweek\trevenue\n2026-W53\t4.95\n2027-W01\t0.50\nTOTAL\t5.45\n",
            "C%2F3.txt": "customer\tC/3\nweek\trevenue\n2026-W53\t7.00\nTOTAL\t7.00\n",
            "C%2E1.txt": "customer\tC.1\nweek\trevenue\n2027-W01\t1.00\nTOTAL\t1.00\n"
          }
        }
      }
    },
    {
