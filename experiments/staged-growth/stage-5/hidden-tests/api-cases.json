      ],
      "expect": {
        "returns": {
          "records": [
            {
              "orderId": "1",
              "customerId": "P1",
              "orderDate": "2026-03-01",
              "sku": "A",
              "quantity": 2,
              "unitPriceCents": 100,
              "discountPercent": 0,
              "notes": ""
            },
            {
              "orderId": "2",
              "customerId": "P1",
              "orderDate": "2026-03-02",
              "sku": "B",
              "quantity": 1,
              "unitPriceCents": 250,
              "discountPercent": 20,
              "notes": "x"
            }
          ],
          "warnings": [
            {
              "file": "orders.pipe",
              "location": "4",
              "reason": {
                "$anyString": true
              }
            },
            {
              "file": "orders.pipe",
              "location": "5",
              "reason": "too few fields"
            },
            {
              "file": "orders.pipe",
              "location": "6",
              "reason": {
                "$anyString": true
              }
            }
          ]
        }
      }
    },
