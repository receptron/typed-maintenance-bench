    {
      "id": "s5-api-register-returns",
      "description": "registerFormat returns undefined",
      "call": "registerFormat",
      "args": [
        {
          "name": "pipe",
          "extensions": [
            ".pipe"
          ],
          "parse": {
            "$plugin": "pipe"
          }
        }
      ],
      "expect": {
        "returns": {
          "$undefined": true
        }
      }
    },
    {
      "id": "s5-api-plugin-read",
