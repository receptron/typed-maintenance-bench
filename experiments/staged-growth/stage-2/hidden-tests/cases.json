      "id": "s2-format-json-dat",
      "description": "--format json on a .dat file",
      "args": [
        "--input",
        "basic.dat",
        "--group-by",
        "day",
        "--format",
        "json"
      ],
      "expect": {
        "exitCode": 0,
        "stdout": "day\trevenue\n2026-01-04\t1.98\n2026-01-05\t5.85\n2026-01-06\t10.20\nTOTAL\t18.03\n",
        "stderrPrefixes": []
      }
    },
    {
      "id": "s2-format-before-input",
      "description": "--format given before --input",
      "args": [
        "--format",
        "json",
        "--group-by",
        "day",
        "--input",
        "basic.dat"
      ],
      "expect": {
        "exitCode": 0,
        "stdout": "day\trevenue\n2026-01-04\t1.98\n2026-01-05\t5.85\n2026-01-06\t10.20\nTOTAL\t18.03\n",
        "stderrPrefixes": []
      }
    },
    {
      "id": "s2-format-overrides-extension",
      "description": "--format csv on JSON content: the header has no required columns",
      "args": [
        "--input",
        "basic.json",
        "--group-by",
        "day",
        "--format",
        "csv"
      ],
      "expect": {
        "exitCode": 2,
        "stdout": "",
        "stderrNonEmpty": true
      }
    },
    {
      "id": "s2-typed-json-rounding",
      "description": "JSON numbers that go wrong in floating point",
      "args": [
        "--input",
        "typed.json",
        "--group-by",
        "sku"
      ],
      "expect": {
        "exitCode": 0,
        "stdout": "sku\trevenue\nA\t0.03\nB\t0.02\nC\t0.28\nD\t130.13\nE\t0.58\nF\t0.00\nG\t0.00\nTOTAL\t131.04\n",
        "stderrPrefixes": []
      }
    },
    {
      "id": "s2-invalid-json",
      "description": "Non-object elements, wrong types, booleans, objects, null as empty, a number id duplicating nothing, exponent numbers",
      "args": [
        "--input",
        "invalid.json",
        "--group-by",
        "sku"
      ],
      "expect": {
        "exitCode": 0,
        "stdout": "sku\trevenue\nA\t2.00\nB\t2.70\nD\t100.00\nE\t0.10\nTOTAL\t104.80\n",
        "stderrPrefixes": [
          "invalid.json:#2:",
          "invalid.json:#3:",
          "invalid.json:#4:",
          "invalid.json:#5:",
          "invalid.json:#6:",
          "invalid.json:#7:",
          "invalid.json:#8:",
          "invalid.json:#9:",
          "invalid.json:#10:",
          "invalid.json:#11:",
          "invalid.json:#13:",
          "invalid.json:#14:"
        ]
      }
    },
    {
      "id": "s2-invalid-jsonl",
      "description": "Bad lines, an empty line, a non-object line, a duplicate",
      "args": [
        "--input",
        "invalid.jsonl",
        "--group-by",
        "sku"
      ],
      "expect": {
        "exitCode": 0,
        "stdout": "sku\trevenue\nA\t1.00\nB\t1.00\nTOTAL\t2.00\n",
        "stderrPrefixes": [
          "invalid.jsonl:2:",
          "invalid.jsonl:4:",
          "invalid.jsonl:5:",
          "invalid.jsonl:7:",
          "invalid.jsonl:8:"
        ]
      }
    },
    {
      "id": "s2-invalid-yaml",
      "description": "Non-mapping element, impossible date, boolean discount; dates in a time zone behind UTC",
      "args": [
        "--input",
        "invalid.yaml",
        "--group-by",
        "day"
      ],
      "env": {
        "TZ": "Pacific/Honolulu"
      },
      "expect": {
        "exitCode": 0,
        "stdout": "day\trevenue\n2026-07-01\t2.50\n2026-07-02\t0.15\nTOTAL\t2.65\n",
        "stderrPrefixes": [
          "invalid.yaml:#2:",
          "invalid.yaml:#3:",
          "invalid.yaml:#5:"
        ]
      }
    },
    {
      "id": "s2-invalid-xlsx",
      "description": "Empty row skipped, fractional quantity, three-decimal price, a string id duplicating a number id; dates ahead of UTC",
