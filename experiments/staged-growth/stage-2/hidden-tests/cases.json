      "args": [
        "--input",
        "basic.yaml",
        "--group-by",
        "day"
      ],
      "env": {
        "TZ": "Asia/Tokyo"
      },
      "expect": {
        "exitCode": 0,
        "stdout": "day\trevenue\n2026-01-04\t1.98\n2026-01-05\t5.85\n2026-01-06\t10.20\nTOTAL\t18.03\n",
        "stderrPrefixes": []
      }
    },
    {
      "id": "s2-yaml-sku",
      "description": "YAML numbers 1.20 and 0.10 read as 1.2 and 0.1",
