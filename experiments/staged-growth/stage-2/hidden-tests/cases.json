{
  "cases": [
    {
      "id": "s2-json-day",
      "description": "JSON array of string values",
      "args": [
        "--input",
        "basic.json",
        "--group-by",
        "day"
      ],
      "expect": {
        "exitCode": 0,
        "stdout": "day\trevenue\n2026-01-04\t1.98\n2026-01-05\t5.85\n2026-01-06\t10.20\nTOTAL\t18.03\n",
        "stderrPrefixes": []
      }
    },
    {
      "id": "s2-json-sku",
      "description": "JSON by sku",
      "args": [
        "--input",
        "basic.json",
        "--group-by",
        "sku"
      ],
      "expect": {
        "exitCode": 0,
        "stdout": "sku\trevenue\nAPPLE\t13.80\nKIWI\t1.98\nPEAR\t2.25\nTOTAL\t18.03\n",
        "stderrPrefixes": []
      }
    },
    {
      "id": "s2-jsonl-day",
      "description": "JSON Lines",
      "args": [
        "--input",
        "basic.jsonl",
        "--group-by",
        "day"
      ],
      "expect": {
        "exitCode": 0,
        "stdout": "day\trevenue\n2026-01-04\t1.98\n2026-01-05\t5.85\n2026-01-06\t10.20\nTOTAL\t18.03\n",
        "stderrPrefixes": []
      }
    },
    {
      "id": "s2-yaml-day",
      "description": "YAML with unquoted dates and numbers",
