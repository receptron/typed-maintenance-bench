        "stderrPrefixes": []
      }
    },
    {
      "id": "s2-yaml-day-honolulu",
      "description": "YAML dates must not shift in a time zone behind UTC",
      "args": [
        "--input",
        "basic.yaml",
        "--group-by",
        "day"
      ],
      "env": {
        "TZ": "Pacific/Honolulu"
      },
      "expect": {
        "exitCode": 0,
