  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "typescript": "6.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
